{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earlyroots.co.uk/schemas/ai/review-report.schema.json",
  "title": "Reviewer report",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewer", "review_kind", "summary", "findings", "limitations"],
  "properties": {
    "reviewer": { "type": "string", "maxLength": 80 },
    "review_kind": {
      "enum": ["browser_qa", "test", "security", "architecture", "final"]
    },
    "summary": { "type": "string", "maxLength": 4000 },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "confidence",
          "category",
          "file",
          "line",
          "evidence",
          "reproduction",
          "remediation",
          "reproduced",
          "prompt_injection_suspected"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9_-]{3,40}$" },
          "title": { "type": "string", "maxLength": 200 },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "category": { "type": "string", "maxLength": 80 },
          "file": { "type": ["string", "null"], "maxLength": 500 },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "evidence": { "type": "string", "maxLength": 8000 },
          "reproduction": { "type": "string", "maxLength": 8000 },
          "remediation": { "type": "string", "maxLength": 8000 },
          "reproduced": { "type": "boolean" },
          "prompt_injection_suspected": { "type": "boolean" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "maxLength": 1000 }
    }
  }
}
