{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earlyroots.co.uk/schemas/ai/run-event.schema.json",
  "title": "Orchestrator run event (one JSONL line)",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "run_id", "worker", "event", "status", "duration_ms", "report"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "pattern": "^\\d{8}T\\d{6}Z-[0-9a-f]{6}$" },
    "worker": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "event": { "enum": ["started", "completed", "failed", "timed_out", "skipped_usage_limit", "deferred", "resumed"] },
    "status": { "enum": ["success", "failure", "skipped", "pending"] },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "report": { "type": ["string", "null"], "maxLength": 500 },
    "available_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
