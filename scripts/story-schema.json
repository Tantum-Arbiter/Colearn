{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "story-data.schema.json",
  "title": "Story Data",
  "description": "Schema for story-data.json files",
  "type": "object",
  "required": ["id", "title", "category", "pages"],
  "definitions": {
    "localizedText": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "pl": { "type": "string" },
        "es": { "type": "string" },
        "de": { "type": "string" },
        "fr": { "type": "string" },
        "it": { "type": "string" },
        "pt": { "type": "string" },
        "ja": { "type": "string" },
        "ar": { "type": "string" },
        "tr": { "type": "string" },
        "nl": { "type": "string" },
        "da": { "type": "string" },
        "la": { "type": "string" },
        "zh": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ageGroupText": {
      "type": "object",
      "description": "Text keyed by age group (1-2, 2-4, 4-6), then by language",
      "properties": {
        "1-2": { "$ref": "#/definitions/localizedText" },
        "2-4": { "$ref": "#/definitions/localizedText" },
        "4-6": { "$ref": "#/definitions/localizedText" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "stateAfter": {
      "type": "object",
      "required": ["image", "position", "size"],
      "properties": {
        "image": { "type": "string", "description": "The protected reveal patch shown as the challenge resolves" },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "size": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": 0, "maximum": 1 },
            "height": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "hotspot": {
      "type": "object",
      "description": "Where a scene item sits in the page art, in fractions of the whole master picture",
      "required": ["position", "size"],
      "properties": {
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "size": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": 0, "maximum": 1 },
            "height": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "challengeBand": {
      "type": "object",
      "required": ["gesture", "items"],
      "properties": {
        "gesture": { "type": "string", "enum": ["tap", "tap-place", "drag"] },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique story identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "category": {
      "type": "string",
      "enum": ["personalized", "bedtime", "adventure", "nature", "friendship", "learning", "fantasy", "music", "activities", "growing"]
    },
    "coverImage": {
      "type": "string",
      "description": "Path to cover thumbnail"
    },
    "isAvailable": {
      "type": "boolean",
      "default": true
    },
    "ageRange": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+$",
      "description": "Age range like 2-5"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of pages in the story"
    },
    "displayFit": {
      "type": "string",
      "enum": ["contain", "cover"],
      "description": "How the reader fits page art: cover for full-screen 4:3 masters (Phase 12 books), contain (the default) for older books that are zoomed from the centre"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "localizedTitle": {
      "type": "object",
      "description": "Localized story titles for multi-language support",
      "properties": {
        "en": { "type": "string" },
        "pl": { "type": "string" },
        "es": { "type": "string" },
        "de": { "type": "string" },
        "fr": { "type": "string" },
        "it": { "type": "string" },
        "pt": { "type": "string" },
        "ja": { "type": "string" },
        "ar": { "type": "string" },
        "tr": { "type": "string" },
        "nl": { "type": "string" },
        "da": { "type": "string" },
        "la": { "type": "string" },
        "zh": { "type": "string" }
      }
    },
    "localizedDescription": {
      "type": "object",
      "description": "Localized story descriptions for multi-language support",
      "properties": {
        "en": { "type": "string" },
        "pl": { "type": "string" },
        "es": { "type": "string" },
        "de": { "type": "string" },
        "fr": { "type": "string" },
        "it": { "type": "string" },
        "pt": { "type": "string" },
        "ja": { "type": "string" },
        "ar": { "type": "string" },
        "tr": { "type": "string" },
        "nl": { "type": "string" },
        "da": { "type": "string" },
        "la": { "type": "string" },
        "zh": { "type": "string" }
      }
    },
    "isPremium": {
      "type": "boolean",
      "default": false
    },
    "isFree": {
      "type": "boolean",
      "default": false,
      "description": "Whether the story is free to download without subscription"
    },
    "isReferralReward": {
      "type": "boolean",
      "default": false,
      "description": "Whether the story is unlocked via share/referral"
    },
    "author": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "description": "Filter tags for story categorization. 15 children's genres available.",
      "items": {
        "type": "string",
        "enum": ["calming", "bedtime", "adventure", "learning", "music", "family-exercises", "imagination-games", "animals", "friendship", "nature", "fantasy", "counting", "emotions", "silly", "rhymes", "interactive"]
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "awards": {
      "type": "array",
      "description": "Badges this book awards: for finishing it, or for completing the challenge on one page. Each achievementId must be defined in cms-achievements/.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["achievementId", "trigger"],
        "properties": {
          "achievementId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "trigger": {
            "oneOf": [
              { "const": "finish" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["challengePageId"],
                "properties": { "challengePageId": { "type": "string" } }
              }
            ]
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pageNumber", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "enum": ["cover", "story"]
          },
          "text": {
            "type": "string"
          },
          "localizedText": {
            "type": "object",
            "description": "Age-grouped localized page text. Keys are age groups (1-2, 2-4, 4-6). Values are localized text objects with language codes as keys.",
            "properties": {
              "1-2": {
                "type": "object",
                "properties": {
                  "en": { "type": "string" }, "pl": { "type": "string" }, "es": { "type": "string" },
                  "de": { "type": "string" }, "fr": { "type": "string" }, "it": { "type": "string" },
                  "pt": { "type": "string" }, "ja": { "type": "string" }, "ar": { "type": "string" },
                  "tr": { "type": "string" }, "nl": { "type": "string" }, "da": { "type": "string" },
                  "la": { "type": "string" }, "zh": { "type": "string" }
                }
              },
              "2-4": {
                "type": "object",
                "properties": {
                  "en": { "type": "string" }, "pl": { "type": "string" }, "es": { "type": "string" },
                  "de": { "type": "string" }, "fr": { "type": "string" }, "it": { "type": "string" },
                  "pt": { "type": "string" }, "ja": { "type": "string" }, "ar": { "type": "string" },
                  "tr": { "type": "string" }, "nl": { "type": "string" }, "da": { "type": "string" },
                  "la": { "type": "string" }, "zh": { "type": "string" }
                }
              },
              "4-6": {
                "type": "object",
                "properties": {
                  "en": { "type": "string" }, "pl": { "type": "string" }, "es": { "type": "string" },
                  "de": { "type": "string" }, "fr": { "type": "string" }, "it": { "type": "string" },
                  "pt": { "type": "string" }, "ja": { "type": "string" }, "ar": { "type": "string" },
                  "tr": { "type": "string" }, "nl": { "type": "string" }, "da": { "type": "string" },
                  "la": { "type": "string" }, "zh": { "type": "string" }
                }
              }
            },
            "additionalProperties": false
          },
          "backgroundImage": {
            "type": "string",
            "description": "Asset path reference"
          },
          "characterImage": {
            "type": "string",
            "description": "Asset path reference"
          },
          "interactionType": {
            "type": "string",
            "enum": ["none", "interactive_state_change", "music_challenge", "learning_challenge"],
            "description": "Interaction type for this page"
          },
          "interactiveElements": {
            "type": "array",
            "description": "Interactive elements (reveal, toggle, drag) on this page",
            "items": {
              "type": "object",
              "required": ["id", "type", "image", "position", "size"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": ["reveal", "toggle", "drag"]
                },
                "image": {
                  "type": "string",
                  "description": "Asset path for the interactive element image"
                },
                "position": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 1 },
                    "y": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                },
                "size": {
                  "type": "object",
                  "required": ["width", "height"],
                  "properties": {
                    "width": { "type": "number", "minimum": 0, "maximum": 1 },
                    "height": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                },
                "hitArea": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 1 },
                    "y": { "type": "number", "minimum": 0, "maximum": 1 },
                    "width": { "type": "number", "minimum": 0, "maximum": 1 },
                    "height": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            }
          },
          "learningChallenge": {
            "type": "object",
            "description": "A learning challenge played over this page; present when interactionType is learning_challenge. The engine is chosen from family.",
            "required": ["challengeId", "briefInteractionId", "mechanicId", "family", "adapter", "assessmentMode", "audioDependent", "domain", "skillId", "copy", "items", "target", "byAge", "allowSkip", "isMusicGate"],
            "properties": {
              "challengeId": { "type": "string", "minLength": 1 },
              "briefInteractionId": { "type": "string", "minLength": 1 },
              "mechanicId": { "type": "string", "pattern": "^[A-Z][0-9]{2}$" },
              "family": {
                "type": "string",
                "enum": ["choose", "tap_scene", "sequence", "music_audio", "quantities", "assign_sort", "authored_sim", "snap_build", "navigate", "trace_draw"]
              },
              "adapter": { "type": "string", "minLength": 1 },
              "assessmentMode": { "type": "string", "enum": ["guided_observable", "exploratory_multiple_valid"] },
              "audioDependent": { "type": "boolean" },
              "domain": { "type": "string", "enum": ["maths", "language", "music", "science", "social", "creative"] },
              "skillId": { "type": "string" },
              "copy": {
                "type": "object",
                "required": ["title", "setupLine", "instruction", "successLine", "onSkip", "parentPrompt", "hints"],
                "properties": {
                  "title": { "$ref": "#/definitions/ageGroupText" },
                  "setupLine": { "$ref": "#/definitions/ageGroupText" },
                  "instruction": { "$ref": "#/definitions/ageGroupText" },
                  "successLine": { "$ref": "#/definitions/ageGroupText" },
                  "onSkip": { "$ref": "#/definitions/ageGroupText" },
                  "parentPrompt": { "$ref": "#/definitions/ageGroupText" },
                  "hints": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/ageGroupText" }
                  }
                },
                "additionalProperties": false
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                    "image": {
                      "type": "string",
                      "description": "Asset path for the item cut-out, rendered with the book; every choose item has one"
                    },
                    "label": { "$ref": "#/definitions/localizedText" },
                    "hotspot": { "$ref": "#/definitions/hotspot" },
                    "outcome": {
                      "type": "object",
                      "description": "What this choice leads to, when it differs from the challenge's shared successLine and stateAfter; tips are up to three things to do, shown beside the chosen picture until the grown-up taps Next; storyText replaces the page's words with this choice's own telling",
                      "properties": {
                        "successLine": { "$ref": "#/definitions/ageGroupText" },
                        "stateAfter": { "$ref": "#/definitions/stateAfter" },
                        "tips": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "items": { "$ref": "#/definitions/ageGroupText" }
                        },
                        "storyText": {
                          "$ref": "#/definitions/ageGroupText",
                          "description": "The page's own story text when this choice is made, in place of the page text; it is the story told the chosen way"
                        }
                      },
                      "minProperties": 1,
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "target": {
                "type": "string",
                "description": "The item id a guided mechanic looks for; empty for an open mechanic"
              },
              "byAge": {
                "type": "object",
                "required": ["1-2", "2-4", "4+"],
                "properties": {
                  "1-2": { "$ref": "#/definitions/challengeBand" },
                  "2-4": { "$ref": "#/definitions/challengeBand" },
                  "4+": { "$ref": "#/definitions/challengeBand" }
                },
                "additionalProperties": false
              },
              "stateAfter": { "$ref": "#/definitions/stateAfter" },
              "fallbackElementId": { "type": "string" },
              "allowSkip": { "type": "boolean", "const": true },
              "isMusicGate": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "musicChallenge": {
            "type": "object",
            "description": "Music challenge configuration for this page",
            "required": ["enabled", "instrumentId", "promptText", "mode", "autoPlaySuccessSong", "allowSkip", "micRequired", "fallbackAllowed", "hintLevel"],
            "properties": {
              "enabled": { "type": "boolean" },
              "instrumentId": { "type": "string", "description": "References a registered instrument asset" },
              "promptText": { "type": "string", "description": "Narrative prompt for the music challenge" },
              "mode": {
                "type": "string",
                "enum": ["guided", "free_play_optional"]
              },
              "songId": { "type": "string", "description": "References a practice song by ID from the song registry (preferred over requiredSequence)" },
              "requiredSequence": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Explicit note sequence (optional if songId is provided)"
              },
              "successSongId": { "type": "string", "description": "Legacy -no longer used" },
              "successStateId": { "type": "string", "description": "Optional page state change on success" },
              "autoPlaySuccessSong": { "type": "boolean" },
              "allowSkip": { "type": "boolean" },
              "micRequired": { "type": "boolean" },
              "fallbackAllowed": { "type": "boolean" },
              "hintLevel": {
                "type": "string",
                "enum": ["none", "minimal", "standard", "verbose"]
              }
            }
          }
        }
      }
    }
  }
}
