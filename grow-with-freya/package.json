{
  "name": "grow-with-freya",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "_comment": "CI/CD pipeline test - snapshots aligned with CI environment",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:go": "expo start --go -c",
    "start:go:tunnel": "expo start --go -c --tunnel",
    "start:dev": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests=false",
    "test:onboarding": "jest __tests__/components/onboarding",
    "test:auth": "jest __tests__/auth",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:performance": "jest --testPathPattern=__tests__/performance",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:performance",
    "type-check": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "build:all": "expo export",
    "doctor": "expo doctor",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "eas:build:dev": "eas build --profile development",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:prod": "eas build --profile production",
    "eas:submit": "eas submit",
    "dev:reset": "npm run start:clear && npm run prebuild:clean",
    "ci:setup": "npm ci && npm run type-check && npm run test:ci",
    "local:build": "npm run type-check && npm run test:ci && npm run build:web",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "release:prepare": "npm run ci:setup && npm run build:web",
    "prepare": "cd .. && husky install || true",
    "pre-commit": "lint-staged",
    "validate": "npm run type-check && npm run lint && npm run test:ci",
    "e2e": "./.maestro/run.sh",
    "e2e:smoke": "./.maestro/run.sh --include-tags=smoke",
    "e2e:stubs": "../wiremock-server/run-local.sh",
    "e2e:metro": "EXPO_PUBLIC_E2E=1 EXPO_PUBLIC_GATEWAY_URL=http://localhost:8080 expo start --dev-client --clear"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@lottiefiles/dotlottie-react": "^0.17.12",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/react-native": "~7.11.0",
    "country-flag-icons": "^1.6.20",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "i18next": "^24.2.3",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.7.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.10.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-super-grid": "^6.0.2",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "husky": "^9.1.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.6.2",
    "react-native-web": "^0.21.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "^1.30.2",
    "lightningcss-darwin-x64": "^1.30.2",
    "lightningcss-linux-arm64-gnu": "^1.30.2",
    "lightningcss-linux-arm64-musl": "^1.30.2",
    "lightningcss-linux-x64-gnu": "^1.30.2",
    "lightningcss-linux-x64-musl": "^1.30.2",
    "lightningcss-win32-arm64-msvc": "^1.30.2",
    "lightningcss-win32-x64-msvc": "^1.30.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx}": [
      "bash -c 'tsc --noEmit'"
    ]
  },
  "private": true
}
